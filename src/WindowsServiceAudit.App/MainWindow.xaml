<Window x:Class="WindowsServiceAudit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Audit" Icon="Assets/WindowsAudit.ico" Height="820" Width="1500" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}" Loaded="Window_Loaded">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
    <DockPanel x:Name="AccessibleLayout" LastChildFill="True">
        <Menu DockPanel.Dock="Top" Background="White" Padding="8,3">
            <MenuItem Header="_File">
                <MenuItem Header="Edit _whitelist…" Click="EditWhitelist_Click" />
                <Separator />
                <MenuItem Header="_Export CSV…" Click="ExportCsv_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ViewResultsMenuItem" Header="_Results" IsEnabled="False" Click="ViewResults_Click" />
                <Separator />
                <MenuItem x:Name="AccessibilityMenuItem" Header="Enhanced _accessibility" IsCheckable="True"
                          Click="Accessibility_Click" />
                <MenuItem Header="_Increase text size" IsEnabled="{Binding IsChecked, ElementName=AccessibilityMenuItem}" InputGestureText="Ctrl++" Click="IncreaseText_Click" />
                <MenuItem Header="_Decrease text size" IsEnabled="{Binding IsChecked, ElementName=AccessibilityMenuItem}" InputGestureText="Ctrl+-" Click="DecreaseText_Click" />
                <MenuItem Header="_Normal text size" IsEnabled="{Binding IsChecked, ElementName=AccessibilityMenuItem}" InputGestureText="Ctrl+0" Click="ResetText_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Scan Windows Services…" Click="RunAudit_Click" />
                <MenuItem Header="Stop / _Disable Services" Click="OpenServices_Click" />
                <Separator />
                <MenuItem Header="_Add or remove programs" Click="OpenInstalledApps_Click" />
                <MenuItem Header="Startup A_pps" Click="OpenStartupApps_Click" />
                <Separator />
                <MenuItem Header="_Cleanup Large Files" Click="CleanupLargeFiles_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Getting Started" Click="GettingStarted_Click" />
                <Separator />
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Windows Service Audit" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Local inventory · advisory findings · no service changes" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻  _Scan Windows Services" AutomationProperties.Name="Scan Windows Services"
                            ToolTip="Scan Windows Services (Alt+S)" Background="#087E83" Foreground="White" Click="RunAudit_Click" />
                    <Button Content="☷  _Whitelist" AutomationProperties.Name="Edit whitelist"
                            ToolTip="Edit whitelist (Alt+W)" Click="EditWhitelist_Click" />
                    <Button Content="⇩  _Export CSV" AutomationProperties.Name="Export CSV"
                            ToolTip="Export CSV (Alt+E)" Click="ExportCsv_Click" />
                    <Button Content="?  _Getting Started" AutomationProperties.Name="Getting Started"
                            ToolTip="Getting Started (Alt+G)" Click="GettingStarted_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#F8FAFA" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SERVICES" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="TotalCountText" Grid.Column="1" Text="Not run" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="REVIEW" FontSize="11" FontWeight="Bold" Foreground="#A24B32" VerticalAlignment="Center" Margin="20,0,10,0" />
                <TextBlock x:Name="ReviewCountText" Grid.Column="3" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#A24B32" VerticalAlignment="Center" />
                <Label x:Name="SampleSecondsLabel" Grid.Column="4" Content="SAMPLE (SE_C)" Target="{Binding ElementName=SampleSecondsComboBox}"
                       Padding="0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,10,0" />
                <ComboBox x:Name="SampleSecondsComboBox" Grid.Column="5" Height="32" SelectedIndex="0" VerticalContentAlignment="Center"
                          AutomationProperties.Name="Sample interval in seconds" AutomationProperties.LabeledBy="{Binding ElementName=SampleSecondsLabel}"
                          ToolTip="Wait before capturing process working set (Alt+C)">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="30" />
                </ComboBox>
                <Label x:Name="FilterLabel" Grid.Column="6" Content="FI_LTER" Target="{Binding ElementName=FilterTextBox}"
                       Padding="0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,10,0" />
                <TextBox x:Name="FilterTextBox" Grid.Column="7" Height="32" MinWidth="140" Padding="8,5" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Filter services" AutomationProperties.LabeledBy="{Binding ElementName=FilterLabel}"
                         TextChanged="FilterTextBox_TextChanged" ToolTip="Filter rows by service name, status, path, or category (Alt+L)" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <ProgressBar x:Name="AuditProgressBar" DockPanel.Dock="Right" Width="180" Height="8" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="Choose Scan Windows Services to inspect this computer."
                           AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="ServicesGrid" Margin="18,14" AutoGenerateColumns="True" IsReadOnly="True"
                  AutomationProperties.Name="Windows services inventory"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  CanUserSortColumns="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" RowHeaderWidth="0" AlternationCount="2"
                  Background="White" BorderBrush="{StaticResource LineBrush}"
                  AutoGeneratingColumn="ServicesGrid_AutoGeneratingColumn" />
    </DockPanel>
    </ScrollViewer>
</Window>
