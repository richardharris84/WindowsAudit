<Window x:Class="WindowsServiceAudit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Audit" Icon="Assets/WindowsAudit.ico" Height="820" Width="1500" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}" Loaded="Window_Loaded">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Background="White" Padding="8,3">
            <MenuItem Header="File">
                <MenuItem Header="Edit whitelist…" Click="EditWhitelist_Click" />
                <Separator />
                <MenuItem Header="Export CSV…" Click="ExportCsv_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem x:Name="ViewResultsMenuItem" Header="Results" IsEnabled="False" Click="ViewResults_Click" />
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Scan Windows Services…" Click="RunAudit_Click" />
                <MenuItem Header="Stop / Disable Services" Click="OpenServices_Click" />
                <Separator />
                <MenuItem Header="Add or remove programs" Click="OpenInstalledApps_Click" />
                <MenuItem Header="Startup Apps" Click="OpenStartupApps_Click" />
                <Separator />
                <MenuItem Header="Cleanup Large Files" Click="CleanupLargeFiles_Click" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Windows Service Audit" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Local inventory · advisory findings · no service changes" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻  Scan Windows Services" Background="{StaticResource AccentBrush}" Foreground="White" Click="RunAudit_Click" />
                    <Button Content="☷  Whitelist" Click="EditWhitelist_Click" />
                    <Button Content="⇩  Export CSV" Click="ExportCsv_Click" />
                    <Button Content="?  About" Click="About_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#F8FAFA" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SERVICES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="TotalCountText" Grid.Column="1" Text="Not run" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="REVIEW" FontSize="11" FontWeight="Bold" Foreground="#A24B32" VerticalAlignment="Center" Margin="20,0,10,0" />
                <TextBlock x:Name="ReviewCountText" Grid.Column="3" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#A24B32" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="SAMPLE (SEC)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="20,0,10,0" />
                <ComboBox x:Name="SampleSecondsComboBox" Grid.Column="5" Height="32" SelectedIndex="0" VerticalContentAlignment="Center" ToolTip="Wait before capturing process working set">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="30" />
                </ComboBox>
                <TextBlock Grid.Column="6" Text="FILTER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="20,0,10,0" />
                <TextBox x:Name="FilterTextBox" Grid.Column="7" Height="32" Padding="8,5" VerticalContentAlignment="Center" TextChanged="FilterTextBox_TextChanged" ToolTip="Filter rows by service name, status, path, or category" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <ProgressBar x:Name="AuditProgressBar" DockPanel.Dock="Right" Width="180" Height="8" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="Choose Scan Windows Services to inspect this computer." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="ServicesGrid" Margin="18,14" AutoGenerateColumns="True" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  CanUserSortColumns="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" RowHeaderWidth="0" AlternationCount="2"
                  Background="White" BorderBrush="{StaticResource LineBrush}"
                  AutoGeneratingColumn="ServicesGrid_AutoGeneratingColumn" />
    </DockPanel>
</Window>
