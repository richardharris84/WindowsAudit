<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WindowsServiceAudit.Core\WindowsServiceAudit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\README.md" Link="Assets\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="..\..\docs\**\*.md" Link="Assets\docs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="Assets\whitelist.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Resource Include="Assets\WindowsAudit.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\WindowsAudit.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>WindowsAudit</AssemblyName>
    <Product>Windows Audit</Product>
    <Version>1.0.4.0</Version>
  </PropertyGroup>

</Project>
